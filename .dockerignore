# Dependencies + build output are reproduced inside the image (bun install + next build).
node_modules
.next
out
build
coverage

# VCS + local tooling
.git
.gitignore
.claude
.vscode
.idea

# Secrets / local env — never bake into the image.
.env
.env.*

# Legacy Access database (PII) — must never end up in a build layer.
*.mdb

# Docs, dev-only setup (local Keycloak realm) and repo meta.
docs
dev
*.md
*.png
!src/pdf/assets/*.png

# Compose files (deployment config, not part of the image build context needs).
compose.yml
compose.dev.yml

# OS cruft
.DS_Store
