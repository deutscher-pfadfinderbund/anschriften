# Kopiere diese Datei nach .env (Produktion, von compose.yml gelesen) bzw.
# .env.local (lokale Entwicklung) und trage echte Werte ein.
# `cp .env.example .env && docker compose up -d` muss ohne weitere Schritte laufen.

# --- Datenbank ---
# Produktion: Der Postgres aus compose.yml (Service `db`, kein Host-Port). Die App
# erreicht ihn containerintern unter dem Hostnamen `db` auf Port 5432. Benutzer,
# Passwort und DB-Name MÜSSEN zum POSTGRES_*-Block unten passen.
#   Sonderzeichen im Passwort müssen in der URL prozentkodiert werden
#   (z. B. `@` -> %40, `:` -> %3A, `/` -> %2F). Am einfachsten ein Passwort ohne
#   Sonderzeichen wählen (`openssl rand -hex 24`).
DATABASE_URL=postgres://anschriften:CHANGE_ME@db:5432/anschriften
# Entwicklung: lokale Postgres aus compose.dev.yml (Host-Port 5544). NICHT in .env,
# sondern in .env.local setzen:
#   DATABASE_URL=postgres://anschriften:anschriften@localhost:5544/anschriften

# --- Postgres-Container (compose.yml, Service `db`) ---
# Compose liest diese Werte automatisch aus .env für die ${…}-Interpolation. Der
# db-Service übernimmt sie beim ERSTEN Start (initdb) — spätere Änderungen wirken
# nur nach Neuanlage des Volumes. POSTGRES_PASSWORD ist Pflicht (ohne bricht der
# gesamte Stack beim `up` ab). Muss mit DATABASE_URL oben übereinstimmen.
POSTGRES_USER=anschriften
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=anschriften

# --- Backup-Service (compose.yml, Service `backup`) ---
# Täglicher pg_dump nach ./backups auf dem Host. Retention: 14 tägliche, 8 wöchentliche.
# SCHEDULE ist ein go-cron-Ausdruck (6 Felder: Sekunde Minute Stunde Tag Monat Wochentag).
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8

# --- better-auth ---
# Zufälliges Secret erzeugen: `openssl rand -base64 32` — PFLICHTFELD, mind. 32 Bytes.
BETTER_AUTH_SECRET=
# Öffentliche Basis-URL der Anwendung.
#   Produktion: https://anschriften.deutscher-pfadfinderbund.de
BETTER_AUTH_URL=http://localhost:3000

# --- Keycloak (OIDC via better-auth genericOAuth) ---
# Produktion: Realm-/Client-Daten des Prod-Keycloak eintragen. Der Client muss die
# Rolle `anschriften` ins ID-Token schreiben (sonst kein Login).
KEYCLOAK_ISSUER=http://localhost:8090/realms/dpb-dev
KEYCLOAK_CLIENT_ID=anschriften
KEYCLOAK_CLIENT_SECRET=dev-secret

# --- Optional ---
# Überschreibt den Basispfad zu src/pdf (templates/fonts/assets). Im Container auf
# /app/src/pdf gesetzt; lokal normalerweise nicht nötig.
# PDF_ASSETS_DIR=/app/src/pdf

# --- Optionales Mail-Modul (aktiv sobald SMTP_HOST + MAIL_FROM gesetzt) ---
# Provider-agnostisch über SMTP (nodemailer). Kein Provider-SDK — ein späterer
# Wechsel (eigener Mailserver, Mailjet, SES, Postmark, Brevo …) ist nur eine
# Änderung dieser Werte. Lokal testbar mit Mailpit (siehe compose.dev.yml):
#   SMTP_HOST=localhost, SMTP_PORT=1025, ohne SMTP_USER/PASS.
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true bei Port 465, sonst false (STARTTLS auf 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DPB Bundeskanzlei <kanzlei@deutscher-pfadfinderbund.de>"
MAIL_BCC_CHUNK_SIZE=50
