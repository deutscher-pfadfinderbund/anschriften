# Copy to .env.local for development (`.env.local` is git-ignored).

# Postgres (dev DB from compose.dev.yml runs on port 5544)
DATABASE_URL=postgres://anschriften:anschriften@localhost:5544/anschriften

# better-auth: REQUIRED, min. 32 bytes — generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Keycloak OIDC (dev realm from compose.dev.yml runs on port 8090)
KEYCLOAK_ISSUER=http://localhost:8090/realms/dpb-dev
KEYCLOAK_CLIENT_ID=anschriften
KEYCLOAK_CLIENT_SECRET=dev-secret
