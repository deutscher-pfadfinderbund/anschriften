# Kopiere diese Datei nach .env (Produktion, von compose.yml gelesen) bzw.
# .env.local (lokale Entwicklung) und trage echte Werte ein.

# --- Datenbank ---
# Produktion: separater, selbst verwalteter Postgres (NICHT Teil dieses Compose).
#   DATABASE_URL=postgres://anschriften:<pass>@<db-host>:5432/anschriften
# Entwicklung: lokale Postgres aus compose.dev.yml (Port 5544).
DATABASE_URL=postgres://anschriften:anschriften@localhost:5544/anschriften

# --- better-auth ---
# Zufälliges Secret erzeugen: `openssl rand -base64 32` — PFLICHTFELD, mind. 32 Bytes.
BETTER_AUTH_SECRET=
# Öffentliche Basis-URL der Anwendung.
#   Produktion: https://anschriften.<domain>
BETTER_AUTH_URL=http://localhost:3000

# --- Keycloak (OIDC via better-auth genericOAuth) ---
# Produktion: Realm-/Client-Daten des Prod-Keycloak eintragen. Der Client muss die
# Rolle `anschriften` ins ID-Token schreiben (sonst kein Login).
KEYCLOAK_ISSUER=http://localhost:8090/realms/dpb-dev
KEYCLOAK_CLIENT_ID=anschriften
KEYCLOAK_CLIENT_SECRET=dev-secret

# --- Optional ---
# Überschreibt den Basispfad zu src/pdf (templates/fonts/assets). Im Container auf
# /app/src/pdf gesetzt; lokal normalerweise nicht nötig.
# PDF_ASSETS_DIR=/app/src/pdf
